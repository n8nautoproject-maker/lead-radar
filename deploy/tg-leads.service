[Unit]
Description=tg-leads: слежение за заявками в Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgleads
WorkingDirectory=/opt/tg-leads
ExecStart=/opt/tg-leads/venv/bin/python -u tg.py watch --backfill 0.25 --search 24
Restart=always
RestartSec=30
# Запрещаем сервису всё лишнее: он читает и пишет только в /opt/tg-leads
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tg-leads

[Install]
WantedBy=multi-user.target
